# Definition for singly-linked list.
# class ListNode:
#     def __init__(self, x):
#         self.val = x
#         self.next = None

class Solution:
    def getIntersectionNode(self, headA: ListNode, headB: ListNode) -> Optional[ListNode]:
        # 遍历 headA，把nodeA放进 set
        # 遍历 headB，看nodeB有没有在set中
        nodeSet = set()
        ln = headA
        while ln:
            nodeSet.add(ln)
            ln = ln.next
        
        ln = headB
        while ln:
            if ln in nodeSet: return ln
            ln = ln.next
        
        return None
